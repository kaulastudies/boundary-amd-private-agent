# Local services only. Do not add API keys or remote model endpoints.
BOUNDARY_HOST=127.0.0.1
BOUNDARY_PORT=8080
BOUNDARY_MODEL_BASE_URL=http://127.0.0.1:8000/v1
BOUNDARY_MODEL_NAME=boundary-qwen3-8b
BOUNDARY_MODEL_TIMEOUT_SECONDS=30
BOUNDARY_DATABASE_PATH=/workspace/boundary-data/boundary.db
BOUNDARY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BOUNDARY_EMBEDDING_DEVICE=cpu
BOUNDARY_RAG_INDEX_PATH=/workspace/boundary-data/rag/boundary.faiss
HF_HOME=/workspace/cache/huggingface
HUGGINGFACE_HUB_CACHE=/workspace/cache/huggingface/hub
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
BOUNDARY_BACKEND_URL=http://127.0.0.1:8080
BOUNDARY_BACKEND_TIMEOUT_MS=60000
